# Quantum Kavacha Platform - Environment Configuration Example
PROJECT_NAME="Quantum Kavacha Platform"
VERSION="2.0.0"
ENVIRONMENT="development"
PORT=8000
HOST="127.0.0.1"

# CORS configuration (JSON string list)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","https://quantum-kavacha.netlify.app"]

# Auth Secret (generate a secure random 32+ char string in production)
JWT_SECRET_KEY="quantum_kavacha_default_secret_replace_in_production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Multimodal Gemini API (Optional - heuristic & local OCR fallback used when absent)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Threat Intelligence Providers (Optional API Keys)
VIRUSTOTAL_API_KEY=""

# Quantum Execution Mode (SIMULATION or HARDWARE)
QUANTUM_MODE="SIMULATION"
IBM_QUANTUM_TOKEN=""
